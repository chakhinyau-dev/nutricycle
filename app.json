{
  "expo": {
    "name": "NutriCycle",
    "slug": "nutricycle",
    "scheme": "nutricycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A4453"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salatmahenoor.nutricycle",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "FJ8T8R2YM5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A3B3A5"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.salatmahenoor.nutricycle"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriCycle needs access to your photo library so you can set your profile picture, or, if you're an admin, upload photos for foods, recipes, and videos in the admin panel.",
          "cameraPermission": "NutriCycle needs access to your camera so you can take a photo of your meal for the Analizar Plato feature, which estimates its calories and macros."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraAllowlist": {
              "android.enablePngCrunchInReleaseBuilds": "false"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "db7da973-e64d-4af2-8884-98e5225f54c0"
      }
    },
    "owner": "chakhinyaus-organization"
  }
}
