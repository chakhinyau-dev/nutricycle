{
  "expo": {
    "name": "NutriCycle",
    "slug": "nutricycle",
    "scheme": "nutricycle",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salatmahenoor.nutricycle",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A3B3A5"
      },
      "package": "com.salatmahenoor.nutricycle",
      "versionCode": 2,
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "extraAllowlist": {
              "android.enablePngCrunchInReleaseBuilds": "false"
            }
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.salatmahenoor.nutricycle"
        }
      ],
      "expo-status-bar",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "db7da973-e64d-4af2-8884-98e5225f54c0"
      }
    },
    "owner": "chakhinyaus-organization"
  }
}
