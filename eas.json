{
  "cli": {
    "version": ">= 12.6.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_VERSION": "20.18.0",
        "EAS_SKIP_AUTO_FINGERPRINT": "true"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
